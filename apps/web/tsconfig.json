{
  "extends": "../../tsconfig.base.json",
  "compilerOptions": {
    "composite": true,
    "rootDir": "./src",
    "outDir": "./dist",
    "tsBuildInfoFile": "./dist/.tsbuildinfo",
    "jsx": "react-jsx",
    "lib": ["ES2022", "DOM", "DOM.Iterable"],
    "paths": {
      "@mini-bim/core/federation": ["../../packages/core/dist/federation/index.d.ts"]
    }
  },
  "references": [
    { "path": "../../packages/core" },
    { "path": "../../packages/view-2d" },
    { "path": "../../packages/view-3d" }
  ],
  "include": ["src/**/*"],
  "exclude": ["node_modules", "dist", "**/*.test.ts", "**/*.test.tsx"]
}
