{
  "$schema": "https://json.schemastore.org/tsconfig",
  "extends": "./tsconfig.base.json",
  "compilerOptions": {
    "noEmit": true,
    "composite": false,
    "declaration": false,
    "declarationMap": false,
    "incremental": false,
    "jsx": "react-jsx",
    "lib": ["ES2022", "DOM", "DOM.Iterable"],
    "baseUrl": ".",
    "paths": {
      "@mini-bim/geometry": ["./packages/geometry/src/index.ts"],
      "@mini-bim/core": ["./packages/core/src/index.ts"],
      "@mini-bim/view-2d": ["./packages/view-2d/src/index.ts"],
      "@mini-bim/view-3d": ["./packages/view-3d/src/index.ts"]
    }
  },
  "include": [
    "packages/*/src/**/*.test.ts",
    "apps/*/src/**/*.test.ts",
    "apps/*/src/**/*.test.tsx"
  ],
  "exclude": ["node_modules", "**/dist/**"]
}
