{
  "name": "@tabax/core",
  "version": "1.0.0",
  "description": "Noyau métier et modèle documentaire BIM (BimDocument, Commands, Undo/Redo) pour Tabax",
  "type": "module",
  "main": "./dist/index.js",
  "types": "./dist/index.d.ts",
  "exports": {
    ".": {
      "types": "./dist/index.d.ts",
      "import": "./dist/index.js"
    }
  },
  "scripts": {
    "build": "tsc -b",
    "clean": "rimraf dist",
    "test": "vitest run",
    "test:watch": "vitest",
    "typecheck": "tsc --noEmit -p tsconfig.test.json"
  },
  "dependencies": {
    "@tabax/geometry": "workspace:*",
    "immer": "^11.0.0",
    "polygon-clipping": "^0.15.7",
    "ulid": "^3.0.2",
    "web-ifc": "^0.0.79"
  },
  "devDependencies": {
    "@types/node": "^22.13.4",
    "fast-check": "^4.10.2",
    "vitest": "^3.0.5"
  }
}
