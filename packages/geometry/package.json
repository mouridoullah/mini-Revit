{
  "name": "@tabax/geometry",
  "version": "0.1.0",
  "description": "Noyau mathématique et géométrique 2D/3D pur pour Tabax",
  "type": "module",
  "main": "./dist/index.js",
  "types": "./dist/index.d.ts",
  "exports": {
    ".": {
      "types": "./dist/index.d.ts",
      "import": "./dist/index.js"
    }
  },
  "scripts": {
    "build": "tsc -b",
    "clean": "rimraf dist",
    "test": "vitest run",
    "test:watch": "vitest",
    "typecheck": "tsc --noEmit -p tsconfig.test.json"
  },
  "devDependencies": {
    "@types/earcut": "^3.2.4",
    "@types/polylabel": "^2.0.0",
    "vitest": "^3.0.5"
  },
  "dependencies": {
    "earcut": "^3.2.4",
    "polygon-clipping": "^0.15.7",
    "polylabel": "^2.1.0"
  }
}
