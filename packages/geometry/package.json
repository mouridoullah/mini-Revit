{
  "name": "@mini-bim/geometry",
  "version": "0.1.0",
  "description": "Noyau mathématique et géométrique 2D/3D pur pour Mini-BIM",
  "type": "module",
  "main": "./dist/index.js",
  "types": "./dist/index.d.ts",
  "exports": {
    ".": {
      "types": "./dist/index.d.ts",
      "import": "./dist/index.js"
    }
  },
  "scripts": {
    "build": "tsc -b",
    "clean": "rimraf dist",
    "test": "vitest run",
    "test:watch": "vitest",
    "typecheck": "tsc --noEmit"
  },
  "devDependencies": {
    "@types/earcut": "^3.2.4",
    "vitest": "^3.0.5"
  },
  "dependencies": {
    "earcut": "^3.2.4"
  }
}
