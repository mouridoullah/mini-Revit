{
  "name": "@tabax/view-2d",
  "version": "1.1.0",
  "description": "Visualiseur et plan 2D impératif Canvas 2D pour Tabax",
  "type": "module",
  "main": "./dist/index.js",
  "types": "./dist/index.d.ts",
  "exports": {
    ".": {
      "types": "./dist/index.d.ts",
      "import": "./dist/index.js"
    }
  },
  "scripts": {
    "build": "tsc -b",
    "clean": "rimraf dist",
    "test": "vitest run",
    "test:watch": "vitest",
    "typecheck": "tsc --noEmit -p tsconfig.test.json"
  },
  "dependencies": {
    "@tabax/core": "workspace:*",
    "@tabax/geometry": "workspace:*"
  },
  "devDependencies": {
    "@types/jsdom": "^30.0.0",
    "@types/node": "^22.13.4",
    "jsdom": "^31.0.0",
    "vitest": "^3.0.5"
  }
}
