{
  "name": "@tabax/view-3d",
  "version": "1.1.0",
  "description": "Visualiseur et gestionnaire de scène 3D Three.js pour Tabax",
  "type": "module",
  "main": "./dist/index.js",
  "types": "./dist/index.d.ts",
  "exports": {
    ".": {
      "types": "./dist/index.d.ts",
      "import": "./dist/index.js"
    }
  },
  "scripts": {
    "build": "tsc -b",
    "clean": "rimraf dist",
    "test": "vitest run",
    "test:watch": "vitest",
    "typecheck": "tsc --noEmit -p tsconfig.test.json"
  },
  "dependencies": {
    "@tabax/geometry": "workspace:*",
    "three": "^0.170.0"
  },
  "devDependencies": {
    "@types/jsdom": "^30.0.0",
    "@types/three": "^0.170.0",
    "jsdom": "^31.0.0",
    "vitest": "^3.0.5"
  }
}
