{
  "name": "mini-bim-monorepo",
  "version": "0.1.0",
  "private": true,
  "description": "Mini-BIM: Logiciel de modélisation architecturale et paramétrique inspiré de Revit",
  "type": "module",
  "scripts": {
    "build": "pnpm --filter \"./packages/*\" run build",
    "test": "pnpm --filter \"./packages/*\" run test",
    "test:watch": "pnpm --filter \"./packages/*\" run test:watch",
    "typecheck": "pnpm --filter \"./packages/*\" run typecheck",
    "lint": "eslint .",
    "lint:fix": "eslint . --fix",
    "format": "prettier --write \"**/*.{ts,tsx,js,json,md}\"",
    "format:check": "prettier --check \"**/*.{ts,tsx,js,json,md}\""
  },
  "devDependencies": {
    "@eslint/js": "^9.20.0",
    "@types/node": "^22.13.4",
    "eslint": "^9.20.1",
    "prettier": "^3.5.1",
    "typescript": "^5.7.3",
    "typescript-eslint": "^8.24.0",
    "vitest": "^3.0.5"
  }
}
