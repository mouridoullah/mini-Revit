{
  "name": "tabax-monorepo",
  "version": "1.0.0",
  "private": true,
  "description": "Tabax — Logiciel de modélisation architecturale et d'ingénierie BIM",
  "type": "module",
  "scripts": {
    "build": "pnpm --filter \"./packages/*\" run build && pnpm --filter \"./apps/*\" run build",
    "test": "pnpm --workspace-concurrency=1 --filter \"./packages/*\" --filter \"./apps/*\" run test",
    "test:watch": "pnpm --filter \"./packages/*\" --filter \"./apps/*\" run test:watch",
    "test:e2e": "pnpm --filter @tabax/web run test:e2e",
    "typecheck": "pnpm --filter \"./packages/*\" --filter \"./apps/*\" run typecheck",
    "dev": "pnpm --filter @tabax/web dev",
    "lint": "eslint .",
    "lint:fix": "eslint . --fix",
    "format": "prettier --write \"**/*.{ts,tsx,js,json,md}\"",
    "format:check": "prettier --check \"**/*.{ts,tsx,js,json,md}\""
  },
  "devDependencies": {
    "@eslint/js": "^9.20.0",
    "@types/node": "^22.13.4",
    "eslint": "^9.20.1",
    "prettier": "^3.5.1",
    "typescript": "^5.7.3",
    "typescript-eslint": "^8.24.0",
    "vitest": "^3.0.5"
  }
}
